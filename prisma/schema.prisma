// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Shipment {
  id             String   @id @default(uuid())
  ownerName      String
  ownerPhone     String
  vehicleNo      String
  driverPhone    String
  pickupLocation String
  dropLocation   String
  offeredAmount  Float
  shipperQuote   Float    @default(0)
  status         String   @default("OFFER_SENT") // OFFER_SENT, ACCEPTED, IN_TRANSIT, COMPLETED, CANCELLED
  botState       String?  // PENDING_CONFIRMATION, WAITING_FOR_DRIVER_NO
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Client {
  id          String     @id @default(uuid())
  name        String
  phone       String     @unique
  truckNumber String?
  address     String?
  shipments   Shipment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model WhatsAppMessage {
  id          String   @id @default(uuid())
  messageId   String   @unique
  senderPhone String
  body        String
  timestamp   String
  createdAt   DateTime @default(now())
}
